---
/**
 * 站内搜索（M4 落地）。构建期由 astro.config.mjs 的 atelierPagefind 集成产出
 * dist/pagefind/ 静态索引；本页按需加载 Pagefind UI（脚本/样式都在运行时动态插入，
 * 用 is:inline 避免 Astro 在构建期解析还不存在的 /pagefind/ 路径）。
 *
 * 设计：
 *  - 零服务端、零常驻 JS：只有访问 /search 才拉取脚本，不进首页首屏预算（E7）；
 *  - UI 全局名与构造参数已实测核验（dist/pagefind/pagefind-ui.js 末尾 window.PagefindUI=...）；
 *  - dev 模式下 dist/pagefind 不存在 → 脚本加载失败时保留可读的降级说明，不留死链；
 *  - 搜索容器 data-pagefind-ignore，避免把空 UI 自身索引进去。
 *
 * CSP（M6-e）：本页是全站唯一的内联可执行脚本，构建期把源码 sha256 登记到
 * public/_headers（scripts/csp-check.mjs）；改动这里必须重新生成，否则 CSP 会拦掉它。
 * 脚本内容刻意保持同步、无外部依赖、无 eval。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索 · Atelier" description="在作品、创作记录与能力中查找" currentPath="/search" seo={{ noindex: true }}>
  <div class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-semibold">搜索</h1>
    <p class="mt-2 opacity-80">输入关键词，在作品、创作记录与能力里查找。索引在每次构建时静态生成，不需要服务端。</p>

    <div id="search" data-pagefind-ignore class="mt-8"></div>

    <noscript>
      <p class="mt-6 text-sm opacity-70">搜索需要 JavaScript。也可以直接浏览 <a href="/products" class="underline">作品</a>、<a href="/log" class="underline">创作日志</a> 与 <a href="/capabilities" class="underline">能力</a>。</p>
    </noscript>
    <p id="search-fallback" class="mt-6 hidden text-sm opacity-70">
      搜索索引尚未生成（本地开发模式下正常）。可直接浏览 <a href="/products" class="underline">作品</a>、<a href="/log" class="underline">创作日志</a> 与 <a href="/capabilities" class="underline">能力</a>，或执行 <code>pnpm build</code> 生成索引后预览。
    </p>
  </div>
</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

<script is:inline>
  (function () {
    var host = document.getElementById('search');
    if (!host) return;

    var script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = function () {
      if (typeof window.PagefindUI !== 'function') {
        document.getElementById('search-fallback').classList.remove('hidden');
        return;
      }
      new window.PagefindUI({
        element: '#search',
        showSubResults: true,
        excerptLength: 20,
        pageSize: 8,
        translations: {
          placeholder: '搜索作品、日志、能力…',
          zero_results: '没有找到「[SEARCH_TERM]」相关内容',
          many_results: '找到 [COUNT] 条与「[SEARCH_TERM]」相关的结果',
          one_result: '找到 1 条与「[SEARCH_TERM]」相关的结果',
          clear_search: '清除',
          load_more: '加载更多',
          search_label: '站内搜索',
        },
      });
    };
    script.onerror = function () {
      document.getElementById('search-fallback').classList.remove('hidden');
    };
    document.head.appendChild(script);
  })();
</script>
