---
/**
 * 隐私政策（M5 补全第三方清单）。
 *
 * 关键：下表由 src/lib/config.ts 的**构建期实际值**生成，不是手写一段固定文案。
 * 这样「启用了什么」与「产物里真的有什么」永远一致 —— 与 M4 用探针核验
 * rendered.html / image() 是同一条纪律：配置写上了 ≠ 真的生效了。
 *
 * 概要设计 5.7：无 cookie 分析、事件不含明文 PII、订阅显式同意 + 来源留痕 +
 * 一键退订 + 数据可导出/删除、第三方脚本清单。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { PUBLIC_CONFIG, ANALYTICS_ENABLED } from '../lib/config';

type Row = { what: string; who: string; when: string; data: string };
const rows: Row[] = [];
/** 配置可能是相对路径或无效 URL，别让隐私页把构建弄崩 */
const hostOf = (u: string): string => {
  try {
    return new URL(u, 'https://website.85138175.xyz').hostname;
  } catch {
    return u || '未启用';
  }
};

// 首方：始终存在，且不向第三方发请求
rows.push({
  what: '站内搜索（Pagefind）',
  who: '本站自己（首方，静态文件）',
  when: '仅当你打开「搜索」页时按需加载',
  data: '搜索词只在浏览器内与本站索引比对，不上传、不写 cookie',
});

// 表单：按构建期配置如实反映
rows.push(
  PUBLIC_CONFIG.formEndpoint
    ? {
        what: '在线表单（订阅 / 联系）',
        who: hostOf(PUBLIC_CONFIG.formEndpoint),
        when: '仅当你主动填写并提交时',
        data: '你填的邮箱、可选姓名与留言、同意来源标记',
      }
    : {
        what: '在线表单（订阅 / 联系）',
        who: '未启用',
        when: '—',
        data: '当前构建未配置第三方端点，表单降级为邮件链接，站点不加载任何表单脚本',
      },
);

// 邮件兜底：始终存在（只要配置了收件邮箱）
rows.push({
  what: '邮件兜底（mailto 链接）',
  who: PUBLIC_CONFIG.contactEmail ? '你的本地邮件客户端' : '未配置收件邮箱',
  when: '仅当你点击「写邮件给我」时',
  data: '由你的邮件客户端决定；本站不接触邮件内容',
});

// 预约：仅在配置且点击时
rows.push(
  PUBLIC_CONFIG.calUrl
    ? {
        what: '预约通话（外链）',
        who: hostOf(PUBLIC_CONFIG.calUrl),
        when: '仅当你点击预约链接、主动跳转后',
        data: '跳转后的信息由该服务按其自身政策处理；本站不预先加载它的脚本',
      }
    : {
        what: '预约通话（外链）',
        who: '未启用',
        when: '—',
        data: '当前构建未配置预约链接，不渲染预约入口，不存在死链',
      },
);

// 分析：两项齐全才算启用
rows.push(
  ANALYTICS_ENABLED
    ? {
        what: '隐私友好分析（Umami）',
        who: hostOf(PUBLIC_CONFIG.umamiScriptUrl),
        when: '每次页面浏览（单脚本、defer 加载）',
        data: '匿名聚合的页面 URL / 来源 / 设备类型；不写 cookie，不含明文身份信息',
      }
    : {
        what: '隐私友好分析（Umami）',
        who: '未启用',
        when: '—',
        data: '当前构建未注入任何分析脚本，首屏保持零客户端 JS',
      },
);

const enabledCount = rows.filter((r) => r.who !== '未启用' && !r.who.includes('首方')).length;
---

<BaseLayout title="隐私政策 · Atelier" description="这个站点如何处理你的数据，以及当前启用了哪些第三方服务" currentPath="/about">
  <div class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-semibold">隐私政策</h1>
    <p class="mt-3 text-sm opacity-70">
      这个站是纯静态的：读内容不需要账号、不需要 cookie、不需要加载第三方脚本。
      只有当你<strong>主动</strong>提交表单、点邮件链接或点预约外链时，才会产生一次对外的数据交换。
    </p>

    <div class="prose mt-8 text-sm opacity-85">
      <h2>我收集什么</h2>
      <ul>
        <li>你主动提交的联系/订阅信息（邮箱、可选的姓名与留言）以及同意来源标记。</li>
        <li>若启用了分析：匿名的页面访问事件（页面 URL、来源、设备类型），不含 cookie、不含明文身份信息。</li>
      </ul>

      <h2>我不用它做什么</h2>
      <ul>
        <li>不投放行为广告，不把邮箱出售或共享给第三方。</li>
        <li>不写跨站追踪 cookie；站内分析仅用于了解内容与渠道效果。</li>
        <li>不做跨站画像，不把访问事件与你的真实身份关联。</li>
      </ul>

      <h2>当前构建实际启用的服务</h2>
      <p>
        下表由构建期配置自动生成（不是固定文案）：当前共有 {enabledCount} 项会在你主动操作时
        与第三方产生数据交换。配置一变，这张表随之改变。
      </p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-xs">
          <thead>
            <tr class="border-b border-neutral-400 dark:border-neutral-600">
              <th class="py-2 pr-3 font-semibold">用途</th>
              <th class="py-2 pr-3 font-semibold">接收方</th>
              <th class="py-2 pr-3 font-semibold">何时触发</th>
              <th class="py-2 font-semibold">涉及的数据</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr class="border-b border-neutral-200 align-top dark:border-neutral-800">
                  <td class="py-2 pr-3">{r.what}</td>
                  <td class="py-2 pr-3">{r.who}</td>
                  <td class="py-2 pr-3">{r.when}</td>
                  <td class="py-2">{r.data}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs opacity-70">
        说明：CDN / 托管平台（M7 部署时确定）会按其自身政策处理网络请求日志；
        本站自身不额外注入任何追踪脚本。评论（Giscus）在 R1 未启用，R2 若启用会同步更新本页。
      </p>

      <h2>你的权利</h2>
      <ul>
        <li>订阅需显式勾选同意，记录来源与时间；每封邮件可一键退订。</li>
        <li>可随时要求导出或删除你的订阅/联系记录（<a href="/contact">联系我</a>即可）。</li>
        <li>表单未配置第三方端点、或端点失效时，会降级为邮件链接，不影响你浏览全部内容。</li>
      </ul>

      <p class="text-xs opacity-60">最近更新：{new Date().toISOString().slice(0, 10)}（随构建更新）</p>
    </div>
  </div>
</BaseLayout>
