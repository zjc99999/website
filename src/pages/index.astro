---
/**
 * 首页占位（M1 空构建验证用）。
 *
 * 首屏硬性预算（E6）：身份 1 句 / 价值主张 1 句 / 主 CTA 1 / 次 CTA 1 /
 * 导航 ≤5 / 作品卡 ≤3。M3 会把这里拆成 Hero + ProductCard + CTA 等组件，
 * 但预算不变；M8 把 profile.json 占位文案换成真实内容。
 *
 * 注意：M1 不引入任何客户端 JS（E7 首屏 JS ≤50KB）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const profile = (await getEntry('profile', 'me'))!.data;
---

<BaseLayout>
  <nav slot="nav" aria-label="主导航" class="mx-auto flex max-w-3xl gap-6 px-6 py-5 text-sm">
    <a href="/">首页</a>
    <a href="/products">作品</a>
    <a href="/log">创作日志</a>
    <a href="/capabilities">能力</a>
    <a href="/about">关于</a>
  </nav>

  <!-- L1 / 3 秒层：不滚动即回答「你是谁 / 做什么 / 能帮我什么 / 下一步点哪」 -->
  <section class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-sm opacity-70">{profile.availability}</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">{profile.headline}</h1>
    <p class="mt-3 text-xl">{profile.value}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/contact"
        class="rounded-md bg-neutral-900 px-4 py-2 text-white no-underline dark:bg-white dark:text-neutral-900"
        >聊聊你的项目</a
      >
      <a href="/subscribe" class="rounded-md border px-4 py-2 no-underline">订阅更新</a>
    </div>
  </section>

  <footer slot="footer" class="mx-auto max-w-3xl px-6 py-10 text-sm opacity-70">
    <p>© {new Date().getFullYear()} {profile.name} · 内容与代码同仓，明文可导出</p>
  </footer>
</BaseLayout>
