---
/**
 * 订阅 / 联系表单（M3 组件，M5 接真实端点并做端到端回归）。
 *
 * 设计约束（方案 A / D5）：R1 零后端零密钥。
 *  - 配置了 PUBLIC_FORM_ENDPOINT → 渲染真实 <form method="POST">，交给第三方端点；
 *  - 未配置 → 整块降级为 mailto: 链接；
 *  - **两种情况都保留邮件兜底**：第三方端点宕机 / 被墙 / 表单打不开时，访客仍有
 *    一条能走通的路径（M5 DoD ②）。这同时保证「拔掉动态层，网站（读）仍完整可用」。
 *
 * 隐私（概要设计 5.7）：显式同意、来源留痕（隐藏字段）、蜜罐、一键退订说明、
 * 不存明文 PII 到静态产物。同意时间由接收端点记录，静态站不伪造客户端时间戳。
 *
 * 可逆性：A→B（R1.5 自建 Serverless）只需替换本组件，业务字段不变。
 *
 * 视觉：圆角面板 + 统一 .field 输入框（纯 CSS）。测试钩子逐项保留：
 * data-pagefind-ignore / data-lead-form / data-lead-fallback / 蜜罐 / 隐藏字段。
 */
import { PUBLIC_CONFIG } from '../lib/config';

interface Props {
  /** 'subscribe' | 'contact' —— 决定文案与隐藏来源字段值 */
  mode?: 'subscribe' | 'contact';
  /** 收件邮箱（邮件兜底用），默认取 PUBLIC_CONFIG.contactEmail */
  email?: string;
}

const { mode = 'subscribe', email = PUBLIC_CONFIG.contactEmail } = Astro.props;
const endpoint = PUBLIC_CONFIG.formEndpoint;
const isSubscribe = mode === 'subscribe';
const heading = isSubscribe ? '订阅更新' : '聊聊你的项目';
const consentText = isSubscribe
  ? '我同意接收创作记录与产品更新邮件，可随时一键退订。'
  : '我同意就本次咨询与我联系；我不会把你的邮箱用于其他用途。';
const mailSubject = isSubscribe ? '订阅创作记录' : '想聊聊一个项目';
const mailto = email ? `mailto:${email}?subject=${encodeURIComponent(mailSubject)}` : '';
---

<section class="panel" aria-labelledby="form-heading" data-pagefind-ignore>
  <h2 id="form-heading" class="section-sub">{heading}</h2>

  {
    endpoint ? (
      <form action={endpoint} method="POST" data-lead-form={mode} class="form-body">
        <input type="hidden" name="source" value={`site:${mode}`} />
        <input type="hidden" name="consent_source" value={mode} />
        <input type="hidden" name="_subject" value={mailSubject} />
        <!-- 蜜罐：真人看不见，机器人会填 -->
        <label class="honeypot" aria-hidden="true">
          请勿填写
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
        {!isSubscribe && (
          <div class="field-row">
            <label class="field-label" for="lead-name">怎么称呼你</label>
            <input type="text" id="lead-name" name="name" required class="field" />
          </div>
        )}
        <div class="field-row">
          <label class="field-label" for="lead-email">邮箱</label>
          <input type="email" id="lead-email" name="email" required class="field" />
        </div>
        {!isSubscribe && (
          <div class="field-row">
            <label class="field-label" for="lead-message">想聊什么（一两句话就够）</label>
            <textarea id="lead-message" name="message" rows="3" class="field"></textarea>
          </div>
        )}
        <label class="consent-row">
          <input type="checkbox" name="consent" value="yes" required />
          <span>{consentText}</span>
        </label>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            {isSubscribe ? '订阅' : '发送'}
          </button>
        </div>
      </form>
    ) : (
      <div class="fallback-note">
        <p>在线表单尚未启用，可以直接发邮件给我。网站其余部分不受影响。</p>
        {mailto && (
          <a href={mailto} data-lead-fallback={mode} class="btn btn-ghost">写邮件给我 ↗</a>
        )}
        {!mailto && (
          <p class="lead-note">也可在「关于」页查看其他联系方式。</p>
        )}
      </div>
    )
  }

  {/* DoD ②：无论端点是否配置，都保留一条不依赖动态层的兜底路径 */}
  {
    endpoint && mailto && (
      <p class="fallback-note">
        表单打不开？也可以
        <a href={mailto} data-lead-fallback={mode}>直接发邮件给我</a>。
      </p>
    )
  }

  {
    isSubscribe && (
      <p class="fine-print">
        每封邮件都带退订链接；你的邮箱不会被出售或用于广告。详见<a href="/privacy">隐私政策</a>。
      </p>
    )
  }
</section>
