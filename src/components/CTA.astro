---
/**
 * 次级 CTA 区（L2 底部）。首屏 Hero 已有主/次 CTA，这里只做一次温和的
 * 「下一步」提示，不重复堆按钮（E6 预算：主 1 / 次 1）。
 *
 * 视觉：赤陶渐变顶边 + 微光面板，作为「递进路径」的收束终点（纯 CSS）。
 * 只被 index.astro import。
 */
import { CTA } from '../lib/constants';

interface Props {
  heading?: string;
  note?: string;
}

const {
  heading = '有想一起做的东西？',
  note = '我目前开放合作。先聊聊需求，合适再往下走。',
} = Astro.props;
---

<section class="cta-panel" aria-labelledby="cta-heading">
  <p class="eyebrow">STEP 04 · 开始合作</p>
  <h2 id="cta-heading" class="cta-title">{heading}</h2>
  <p class="cta-note">{note}</p>
  <div class="cta-actions">
    <a href={CTA.primary.href} class="btn btn-primary">{CTA.primary.label}</a>
    <a href={CTA.soft.href} class="btn btn-ghost">{CTA.soft.label}</a>
  </div>
</section>
