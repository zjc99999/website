---
/**
 * L1 / 3 秒层（概要设计 5.2）。首屏不滚动即回答：
 * 「你是谁 / 做什么 / 能帮我什么 / 下一步点哪」。
 *
 * 首屏硬性预算（E6）逐项落在模板里，可逐个 grep 核对：
 *  身份 1 句（headline）、价值主张 1 句（value）、主 CTA 1、次 CTA 1。
 * 作品/日志/概览属于 L2，放在 Hero 之下，不计入首屏 L1。
 *
 * 视觉：暖纸底 + 赤陶微光 + 纯 CSS 点阵/同心圆质感（无图片，不伤 LCP/CLS）。
 * 全部装饰与动效在 global.css，零客户端 JS、零内联 style 属性。
 */
import { CTA } from '../lib/constants';

interface Props {
  availability: string;
  headline: string;
  value: string;
}

const { availability, headline, value } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-art" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <p class="status-chip">
      <span class="status-dot" aria-hidden="true"></span>
      {availability}
    </p>
    <h1 id="hero-title" class="hero-title">{headline}</h1>
    <p class="hero-value">{value}</p>

    <div class="hero-actions">
      <a href={CTA.primary.href} class="btn btn-primary">{CTA.primary.label}</a>
      <a href={CTA.secondary.href} class="btn btn-ghost">{CTA.secondary.label}</a>
    </div>
  </div>
</section>
