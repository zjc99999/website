# 站点公开 URL（M7 已落地：代码默认 https://website.85138175.xyz）
# 驱动 canonical / sitemap / OG / RSS / JSON Feed；换域名时改这里（Cloudflare 构建前设好）
PUBLIC_SITE_URL=https://website.85138175.xyz

# 方案 A（R1 默认）：第三方表单端点（公开 URL，非密钥）
# 留空 → SubscribeForm 整块降级为 mailto: 兜底，站点不加载任何第三方脚本。
# 例：https://formspree.io/f/xxxx 或你自建的接收端点
PUBLIC_FORM_ENDPOINT=
# 邮件兜底收件人（公开）；代码默认 zjc_9999@163.com，可覆盖
PUBLIC_CONTACT_EMAIL=

# 预约外链（可选）：代码默认 https://cal.com/zjc-9999/30min，可覆盖
# 留空 → 不渲染预约入口，不留死链；仅在你点击时才跳转到第三方
PUBLIC_CAL_URL=

# 隐私友好分析（可选，单脚本、无 cookie）：两项必须同时配置才算启用
# 留空 → BaseLayout 不注入任何分析脚本，首屏保持零客户端 JS
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# 方案 B / R1.5（自建 Serverless 时才需要）
# 密钥只存部署平台环境变量，绝不入库
RESEND_API_KEY=
