# 站点公开 URL（M7 换成真实自定义域名，用于 canonical / OG / sitemap）
PUBLIC_SITE_URL=https://atelier.example.com

# 方案 A（R1 默认）：第三方表单端点（公开 URL，非密钥）
# 留空 → SubscribeForm 整块降级为 mailto: 兜底，站点不加载任何第三方脚本。
# 例：https://formspree.io/f/xxxx 或你自建的接收端点
PUBLIC_FORM_ENDPOINT=
PUBLIC_CONTACT_EMAIL=

# 预约外链（可选）：如 https://cal.com/yourname/30min
# 留空 → 不渲染预约入口，不留死链；仅在你点击时才跳转到第三方
PUBLIC_CAL_URL=

# 隐私友好分析（可选，单脚本、无 cookie）：两项必须同时配置才算启用
# 留空 → BaseLayout 不注入任何分析脚本，首屏保持零客户端 JS
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# 方案 B / R1.5（自建 Serverless 时才需要）
# 密钥只存部署平台环境变量，绝不入库
RESEND_API_KEY=
