# 站点公开 URL（M7 换成真实自定义域名，用于 canonical / OG / sitemap）
PUBLIC_SITE_URL=https://atelier.example.com

# 方案 A（R1 默认）：第三方表单端点（公开 URL，非密钥）；留空则 SubscribeForm 退化到 mailto: 兜底
PUBLIC_FORM_ENDPOINT=
PUBLIC_CONTACT_EMAIL=

# 隐私友好分析（可选，单脚本、无 cookie）
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# 方案 B / R1.5（自建 Serverless 时才需要）
# 密钥只存部署平台环境变量，绝不入库
RESEND_API_KEY=
